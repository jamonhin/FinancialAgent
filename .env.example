# Financial Agent Environment Configuration

# OpenAI API Configuration (Required)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL_NAME=gpt-3.5-turbo

# Web Search Configuration (Optional)
SERPER_API_KEY=your_serper_api_key_here

# Development & Debug Configuration (Optional)
DEBUG_THREADING=false
DISABLE_BACKGROUND_THREADS=false
SIMULATE_ANALYSIS_RESULTS=false

# Instructions:
# 1. Copy this file to .env: cp .env.example .env
# 2. Add your actual API keys to the .env file
# 3. Never commit the .env file to version control

# API Key Sources:
# - OpenAI API Key: https://platform.openai.com/api-keys
# - Serper API Key: https://serper.dev/
